.article
  background: color-white
  margin-top: 10px;

  .article-header
    @extend $base-style
    h1
      color: color-blue
    padding-bottom: 10px
    margin: 60px 0 20px
    border-bottom: 1px solid color-grey
    .article-header-meta
        display: flex
        justify-content: flex-start
        align-items: center
        i
            color: color-blue
        div
            padding-left: 5px
            padding-right: 5px
        .category-link
            color: color-font
            text-decoration-line: underline
            &:hover
                color: color-blue

  .article-body
    border-bottom: 1px solid color-grey
    @extend $base-style
    h3, h4
      color: color-blue
    p, ul, ol
      margin-bottom: 2rem
      margin-top: 2rem
      font-size: 1.25em
      text-align: justify
    img
      clear: both
      display: block
      margin: 0 auto
      max-width: 100%
      max-height: 100%
    .read-more
      display: inline-block
      float: right
      text-align: right
      padding: 6px 12px
      border: 1px solid color-grey
      &:hover
        background-color: color-blue-hover
        border-color: color-blue-hover
        color color-white

  #article-nav
    @extend $base-style
    display: flex
    justify-content: space-between
    .article-nav-link-wrap
      flex-shrink: 0;
      max-width: 50%;

      padding: 6px 12px
      border-bottom: 1px solid color-grey
      border-left: 1px solid color-grey
      border-right: 1px solid color-grey
      &:hover
        background-color: color-blue-hover
        border-color: color-blue-hover
        color color-white
      &:only-child
        margin-left: auto
